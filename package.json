{
  "name": "adubator-dub-siren",
  "version": "1.0.0",
  "main": "./index.js",
  "private": true,
  "scripts": {
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && expo start",
    "android": "export NODE_OPTIONS=--openssl-legacy-provider && expo start --android",
    "ios": "export NODE_OPTIONS=--openssl-legacy-provider && expo start --ios",
    "web": "export NODE_OPTIONS=--openssl-legacy-provider && expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "vercel-build": "expo export --public --platform web && vercel build"
  },
  "dependencies": {
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.47.0",
    "prettier": "^3.0.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
